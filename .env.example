# Cloudflare Account & R2 Object Storage
CLOUDFLARE_ACCOUNT_ID="your_cloudflare_account_id_hex_string"
R2_ACCESS_KEY_ID="your_r2_access_key_id"
R2_SECRET_ACCESS_KEY="your_r2_secret_access_key"
R2_BUCKET_NAME="smile-store-apks"
R2_ENDPOINT="https://your_cloudflare_account_id_hex_string.r2.cloudflarestorage.com"
R2_PUBLIC_URL="" # Leave empty for private storage; non-empty if public media bucket CDN domain is enabled

# Database Connection (PostgreSQL)
DATABASE_URL="postgresql://user:password@hostname:5432/smilestore?sslmode=require"

# Authentication & Session Security (Use JWT_SECRET or AUTH_SECRET)
JWT_SECRET="replace_with_a_secure_random_string_minimum_32_characters_long"

# Administrator Identity & Controls
ADMIN_EMAIL="smileflex2027@gmail.com"
REQUIRE_ADMIN_AUTH="true"
UPLOADS_ENABLED="true"
MAX_APK_SIZE_MB="200"

# Application URLs & Runtime
APP_URL="https://ais-pre-uu3s4j4p7uis6oqgzoxnpq-1033501728034.asia-southeast1.run.app"
CORS_ORIGIN="https://ais-pre-uu3s4j4p7uis6oqgzoxnpq-1033501728034.asia-southeast1.run.app"
NODE_ENV="production"
PORT="3000"
